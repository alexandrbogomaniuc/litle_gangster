  "auditFindings": {
    "targetRtpUnit": {
      "status": "defect_for_calibration",
      "finding": "Profiles store targetRtp as 96.0/94.0/92.0 percent-style values, while the simulator reports observedReturnMultiplierPerRound as a multiplier such as 0.205943."
    },
    "observedReturnFormula": {
      "status": "documented",
      "formula": "sum(round.totalWinMultiplier) / roundCount"
    },
    "totalBetDenominator": {
      "status": "missing_for_calibration",
      "finding": "Simulator does not load game_settings_profiles clusterBaseBetCredits/minTotalBet/defaultTotalBet/maxTotalBet and does not normalize by an explicit total bet denominator."
    },
    "clusterBaseBetHandling": {
      "status": "incomplete",
      "finding": "Cluster paytable wins are treated directly as multipliers; cluster-equivalent bet metadata is not represented in calculations."
    },
    "symbolGridGeneration": {
      "status": "present",
      "finding": "Weighted random symbol generation is deterministic by seed and profile weights."
    },
    "clusterDetection": {
      "status": "present_but_simplified",
      "finding": "Adjacent same-symbol clusters are detected with minimum size 5; wild/rainbow/coin/special are excluded and wild substitution is not modeled."
    },
    "clusterPaytableLookup": {
      "status": "present_but_provisional",
      "finding": "Lookup uses configured symbol and cluster-size ranges, but paytable values are provisional and not certified."
    },
    "cascadeRefillLogic": {
      "status": "present",
      "finding": "Winning cells are removed, columns collapse downward, and refills are generated up to the configured cascade limit."
    },
    "maxWinCapHandling": {
      "status": "present_smoke_only",
      "finding": "Cap is applied to total win multiplier, but no cap hits occurred in diagnostic runs."
    },
    "featureContribution": {
      "status": "incomplete_for_calibration",
      "finding": "Coin reveal contributes to total win, while golden/rainbow/feature mode buckets are diagnostic counters; free-spin and bonus-buy EV are not simulated."
    },
    "bonusBuy": {
      "status": "blocked_pending_ev_model",
      "finding": "bonus_buy_rules exists, but simulator run disabled bonus buy and current EV is not calibrated or certified."
    },
    "freeSpinsFeatureModes": {
      "status": "blocked_pending_simulation_model",
      "finding": "free_spin_rules and feature_mode_rules exist, but current simulator does not execute full free-spin/feature-mode loops."
    },
    "winTierCalculation": {
      "status": "present_smoke_only",
      "finding": "Win tiers are derived from total win multiplier thresholds."
    },
    "seedDeterminism": {
      "status": "present",
      "finding": "Runs are deterministic for model and seed."
    },
    "skeletonStatus": {
      "status": "confirmed",
      "finding": "Simulator is a non-production deterministic smoke simulator, not certification math."
    }
  },
