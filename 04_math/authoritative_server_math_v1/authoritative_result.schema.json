{
  "$schema": "[REDACTED_URL]",
  "title": "Little Gangster Authoritative Result Planning Schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "gameKey",
    "schemaVersion",
    "mathVersion",
    "roundId",
    "bet",
    "totalWin",
    "serverGenerated",
    "browserGenerated",
    "roundCompletion",
    "statePersistence"
  ],
  "properties": {
    "gameKey": { "const": "little-gangster" },
    "schemaVersion": { "const": "v1" },
    "mathVersion": { "type": "string", "minLength": 1 },
    "roundId": { "type": "string", "minLength": 1 },
    "bet": { "type": "number", "minimum": 0 },
    "totalWin": { "type": "number", "minimum": 0 },
    "serverGenerated": { "const": true },
    "browserGenerated": { "const": false },
    "roundCompletion": {
      "type": "object",
      "additionalProperties": true,
      "required": ["roundComplete"],
      "properties": {
        "roundComplete": { "type": "boolean" }
      }
    },
    "statePersistence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["stateVersion"],
      "properties": {
        "stateVersion": { "type": "integer", "minimum": 0 }
      }
    }
  }
}

