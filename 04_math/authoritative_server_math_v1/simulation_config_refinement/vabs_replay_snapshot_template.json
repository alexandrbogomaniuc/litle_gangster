{
  "schemaVersion": "vabs-replay-snapshot-template-v1",
  "artifactType": "deterministic_replay_template",
  "replayPreferred": true,
  "screenshotRequirementStatus": "unverified",
  "screenshotBinaryStored": false,
  "requiredFields": [
    "roundId",
    "modelId",
    "startingGrid",
    "cascadeSteps",
    "finalGrid",
    "winSummary",
    "winTier",
    "capState",
    "featureState",
    "bonusBuyState",
    "rngDrawReferences",
    "stateVersion",
    "roundCompletion",
    "replayPayload"
  ],
  "doNotStore": [
    "raw_rng_seed_secret",
    "wallet_secret",
    "player_private_data",
    "screenshot_binary_unless_required"
  ]
}
