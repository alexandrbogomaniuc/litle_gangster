{
  "$schema": "[REDACTED_URL]",
  "title": "Little Gangster RNG Draw Plan Planning Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["gameKey", "schemaVersion", "rngOwner", "drawCategories"],
  "properties": {
    "gameKey": { "const": "little-gangster" },
    "schemaVersion": { "type": "string", "minLength": 1 },
    "rngOwner": { "const": "server_math" },
    "drawCategories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "whenConsumed", "affectsRtp", "historyRequired", "certificationRequired"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "whenConsumed": { "type": "string", "minLength": 1 },
          "affectsRtp": { "type": "boolean" },
          "historyRequired": { "type": "boolean" },
          "certificationRequired": { "type": "boolean" }
        }
      }
    }
  }
}

