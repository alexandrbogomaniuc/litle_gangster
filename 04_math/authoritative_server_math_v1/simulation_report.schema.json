{
  "$schema": "[REDACTED_URL]",
  "title": "Little Gangster Simulation Report Planning Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["gameKey", "mathVersion", "roundsSimulated", "rtp", "browserAuthorityAllowed", "releaseApproved"],
  "properties": {
    "gameKey": { "const": "little-gangster" },
    "mathVersion": { "type": "string", "minLength": 1 },
    "roundsSimulated": { "type": "integer", "minimum": 1 },
    "rtp": { "type": "number", "minimum": 0 },
    "confidenceInterval": { "type": "string" },
    "volatility": { "type": "string" },
    "featureContribution": { "type": "number", "minimum": 0 },
    "bonusBuyContribution": { "type": "number", "minimum": 0 },
    "capHitFrequency": { "type": "number", "minimum": 0 },
    "browserAuthorityAllowed": { "const": false },
    "releaseApproved": { "const": false }
  }
}

