{
  "$schema": "[REDACTED_URL]",
  "title": "Little Gangster History Snapshot Planning Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gameKey",
    "schemaVersion",
    "roundId",
    "stateVersion",
    "bet",
    "totalWin",
    "roundComplete",
    "events",
    "browserGenerated"
  ],
  "properties": {
    "gameKey": { "const": "little-gangster" },
    "schemaVersion": { "type": "string", "minLength": 1 },
    "roundId": { "type": "string", "minLength": 1 },
    "stateVersion": { "type": "integer", "minimum": 0 },
    "bet": { "type": "number", "minimum": 0 },
    "totalWin": { "type": "number", "minimum": 0 },
    "roundComplete": { "type": "boolean" },
    "browserGenerated": { "const": false },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["eventType", "serverOwned"],
        "properties": {
          "eventType": { "type": "string", "minLength": 1 },
          "serverOwned": { "const": true }
        }
      }
    }
  }
}

