{
  "$schema": "[REDACTED_URL]",
  "$id": "little_gangster_v0_3_donor_feature_parity_result_schema",
  "title": "Little Gangster v0.3 donor-feature-parity backend result contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "gameId",
    "roundId",
    "bet",
    "totalWin",
    "mathVersion",
    "rtpVariant",
    "base_game",
    "max_win_cap",
    "round_completion",
    "state_persistence",
    "wallet_accounting_boundary"
  ],
  "properties": {
    "gameId": {
      "type": [
        "integer",
        "string"
      ]
    },
    "roundId": {
      "type": "string"
    },
    "spinId": {
      "type": [
        "string",
        "null"
      ]
    },
    "operationId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Current-GS/new-games operation placeholder if selected lane requires it."
    },
    "stateVersion": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "clientOperationId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Client idempotency/request correlation only; not outcome authority."
    },
    "mathVersion": {
      "const": "v0.3_donor_feature_parity_provisional"
    },
    "rtpVariant": {
      "enum": [
        "rtp_96",
        "rtp_94",
        "rtp_92"
      ]
    },
    "bet": {
      "type": "number"
    },
    "totalWin": {
      "type": "number"
    },
    "total_win_x_bet": {
      "type": "number"
    },
    "winRatio": {
      "type": "number",
      "description": "totalWin / bet for animation tier selection; advisory thresholds only."
    },
    "winTier": {
      "enum": [
        "none",
        "little",
        "small",
        "medium",
        "large",
        "big",
        "huge",
        "mega"
      ]
    },
    "win_tier_source": {
      "type": "string",
      "description": "Mantis advisory thresholds unless current GS/docs override."
    },
    "base_game": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grid_before",
        "cascade_steps",
        "total_cascade_win",
        "final_grid",
        "golden_squares_before",
        "golden_squares_after",
        "golden_square_events",
        "golden_square_positions",
        "rainbow_positions",
        "rainbow_activation_events",
        "coin_reveals",
        "special_reveals",
        "feature_triggers"
      ],
      "properties": {
        "grid_before": {
          "type": "array",
          "description": "5 rows by 6 columns before cascade evaluation."
        },
        "initial_grid": {
          "type": "array"
        },
        "cascade_steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "cascade_index",
              "grid_before",
              "clusters",
              "removed_cells",
              "dropped_cells",
              "new_symbols",
              "grid_after",
              "cascade_win",
              "total_cascade_win"
            ],
            "properties": {
              "cascade_index": {
                "type": "integer"
              },
              "grid_before": {
                "type": "array"
              },
              "clusters": {
                "type": "array"
              },
              "winning_clusters": {
                "type": "array"
              },
              "removed_cells": {
                "type": "array"
              },
              "dropped_cells": {
                "type": "array"
              },
              "new_symbols": {
                "type": "array"
              },
              "grid_after": {
                "type": "array"
              },
              "cascade_win": {
                "type": "number"
              },
              "total_cascade_win": {
                "type": "number"
              },
              "golden_squares_before": {
                "type": "array"
              },
              "golden_squares_after": {
                "type": "array"
              },
              "rainbow_activation_events": {
                "type": "array"
              },
              "coin_reveals": {
                "type": "array"
              },
              "special_reveals": {
                "type": "array"
              },
              "animation_hint_ids": {
                "type": "array"
              }
            }
          }
        },
        "removed_cells": {
          "type": "array",
          "description": "Flattened round-level removed cells for renderer convenience."
        },
        "dropped_cells": {
          "type": "array"
        },
        "new_symbols": {
          "type": "array"
        },
        "clusters": {
          "type": "array"
        },
        "cascade_index": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Last evaluated cascade index or null if no cascade."
        },
        "cascade_win": {
          "type": "number",
          "description": "Last cascade win or zero."
        },
        "total_cascade_win": {
          "type": "number"
        },
        "final_grid": {
          "type": "array"
        },
        "golden_squares_before": {
          "type": "array"
        },
        "golden_squares_after": {
          "type": "array"
        },
        "golden_square_events": {
          "type": "array"
        },
        "golden_square_positions": {
          "type": "array"
        },
        "persistence_scope": {
          "type": "string"
        },
        "rainbow_positions": {
          "type": "array"
        },
        "rainbow_activation_events": {
          "type": "array"
        },
        "affected_golden_squares": {
          "type": "array"
        },
        "activation_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "coin_reveals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "position",
              "tier",
              "source_event",
              "cascade_index"
            ],
            "properties": {
              "position": {
                "type": "object"
              },
              "tier": {
                "enum": [
                  "bronze",
                  "silver",
                  "gold"
                ]
              },
              "value_x_bet": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "value_units": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "source_event": {
                "type": "string"
              },
              "cascade_index": {
                "type": "integer"
              }
            }
          }
        },
        "special_reveals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "reveal_type",
              "position",
              "source_event",
              "confidence"
            ],
            "properties": {
              "reveal_type": {
                "enum": [
                  "pot_of_gold",
                  "four_leaf_clover",
                  "unknown"
                ]
              },
              "position": {
                "type": "object"
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "source_event": {
                "type": "string"
              },
              "confidence": {
                "enum": [
                  "high",
                  "medium",
                  "low",
                  "blocked"
                ]
              }
            }
          }
        },
        "feature_triggers": {
          "type": "array"
        }
      }
    },
    "feature_mode_state": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "active",
        "mode_key",
        "entry_source",
        "spins_or_rounds_remaining",
        "feature_complete"
      ],
      "properties": {
        "active": {
          "type": "boolean"
        },
        "mode_key": {
          "enum": [
            "none",
            "mode_1",
            "mode_2",
            "mode_3"
          ]
        },
        "mode_name": {
          "type": "string"
        },
        "entry_source": {
          "enum": [
            "base_trigger",
            "bonus_buy",
            "special_symbol",
            "restore",
            "unknown",
            "none"
          ]
        },
        "trigger_condition": {
          "type": "string"
        },
        "spins_or_rounds_remaining": {
          "type": "integer"
        },
        "golden_square_behavior": {
          "type": "string"
        },
        "rainbow_behavior": {
          "type": "string"
        },
        "coin_reveal_behavior": {
          "type": "string"
        },
        "multiplier_behavior": {
          "type": "string"
        },
        "feature_complete": {
          "type": "boolean"
        }
      }
    },
    "bonus_buy_state": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "available",
        "selected_mode",
        "cost_x_bet",
        "ev_status",
        "wallet_accounting_boundary",
        "confirmation_required"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "selected_mode": {
          "enum": [
            "none",
            "mode_1",
            "mode_2",
            "mode_3",
            "unknown"
          ]
        },
        "cost_x_bet": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "betType_or_current_gs_equivalent": {
          "type": "string"
        },
        "ev_status": {
          "type": "string"
        },
        "wallet_accounting_boundary": {
          "type": "string"
        },
        "confirmation_required": {
          "type": "boolean"
        },
        "purchased_feature_start_state": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "max_win_cap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_win_cap_x_bet",
        "possible_max_win_credits",
        "possible_max_win_without_bonus_buy_credits",
        "cap_reached",
        "pre_cap_win",
        "capped_win",
        "cap_reached_at_step",
        "cap_applies_to_base",
        "cap_applies_to_feature_modes",
        "cap_applies_to_bonus_buy"
      ],
      "properties": {
        "max_win_cap_x_bet": {
          "type": "number"
        },
        "possible_max_win_credits": {
          "type": [
            "number",
            "null"
          ]
        },
        "possible_max_win_without_bonus_buy_credits": {
          "type": [
            "number",
            "null"
          ]
        },
        "cap_reached": {
          "type": "boolean"
        },
        "pre_cap_win": {
          "type": "number"
        },
        "pre_cap_win_x_bet": {
          "type": "number"
        },
        "capped_win": {
          "type": "number"
        },
        "capped_win_x_bet": {
          "type": "number"
        },
        "cap_reached_at_step": {
          "type": [
            "string",
            "null"
          ]
        },
        "cap_applies_to_base": {
          "type": "boolean"
        },
        "cap_applies_to_feature_modes": {
          "type": "boolean"
        },
        "cap_applies_to_bonus_buy": {
          "type": "boolean"
        }
      }
    },
    "round_completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_spin_complete",
        "cascade_complete",
        "feature_spin_complete",
        "bonus_buy_purchased_feature_complete",
        "max_win_cap_complete",
        "no_pending_cascade",
        "no_pending_reveal",
        "no_pending_feature_transition",
        "final_state_ready",
        "round_finished",
        "current_gs_equivalent_status"
      ],
      "properties": {
        "base_spin_complete": {
          "type": "boolean"
        },
        "cascade_complete": {
          "type": "boolean"
        },
        "feature_spin_complete": {
          "type": "boolean"
        },
        "bonus_buy_purchased_feature_complete": {
          "type": "boolean"
        },
        "max_win_cap_complete": {
          "type": "boolean"
        },
        "no_pending_cascade": {
          "type": "boolean"
        },
        "no_pending_reveal": {
          "type": "boolean"
        },
        "no_pending_feature_transition": {
          "type": "boolean"
        },
        "final_state_ready": {
          "type": "boolean"
        },
        "round_finished": {
          "type": "boolean"
        },
        "roundFinished_or_equivalent": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "endRoundSignature_or_helper_status": {
          "type": "string"
        },
        "current_gs_equivalent_status": {
          "type": "string"
        }
      }
    },
    "state_persistence": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "roundId",
        "spinId",
        "stateVersion",
        "current_grid",
        "pending_cascades",
        "golden_square_state",
        "feature_mode",
        "bonus_buy_purchase_state",
        "cap_state",
        "recovery_state"
      ],
      "properties": {
        "roundId": {
          "type": "string"
        },
        "spinId": {
          "type": [
            "string",
            "null"
          ]
        },
        "stateVersion": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "clientOperationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "idempotencyKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "current_grid": {
          "type": "array"
        },
        "pending_cascades": {
          "type": "array"
        },
        "golden_square_state": {
          "type": "array"
        },
        "feature_mode": {
          "type": "object"
        },
        "free_spins_remaining": {
          "type": "integer"
        },
        "bonus_buy_purchase_state": {
          "type": "object"
        },
        "cap_state": {
          "type": "object"
        },
        "lastAction_or_current_gs_equivalent": {
          "type": [
            "object",
            "null"
          ]
        },
        "recovery_state": {
          "type": "object"
        }
      }
    },
    "wallet_accounting_boundary": {
      "type": "object",
      "description": "Accounting values for backend/wallet owner. This is not a BSG Common Wallet payload and not browser-owned."
    },
    "registration_metadata_boundary": {
      "type": "object",
      "description": "Display/config metadata only; no executable math."
    },
    "animationHints": {
      "type": "array"
    },
    "rngDebug": {
      "type": [
        "object",
        "null"
      ],
      "description": "Development-only; must not be sent as production client authority."
    },
    "doubleUp": {
      "type": "object",
      "description": "Must state removed_from_active_scope."
    },
    "jackpot": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
