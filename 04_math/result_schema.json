{
  "$schema": "[REDACTED_URL]",
  "additionalProperties": false,
  "properties": {
    "animationHints": {
      "description": "Client rendering hints derived from backend outcome, not RNG authority.",
      "type": "array"
    },
    "baseGame": {
      "additionalProperties": true,
      "properties": {
        "featureTriggers": {
          "type": "array"
        },
        "grid": {
          "type": "array"
        },
        "wins": {
          "type": "array"
        }
      },
      "required": [
        "grid",
        "wins"
      ],
      "type": "object"
    },
    "bet": {
      "additionalProperties": true,
      "properties": {
        "amount": {
          "type": "number"
        },
        "coinDenomination": {
          "type": [
            "number",
            "integer",
            "null"
          ]
        },
        "currency": {
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "type": "object"
    },
    "bonusBuy": {
      "description": "Present only if an optional buy feature was used.",
      "type": [
        "object",
        "null"
      ]
    },
    "freeSpins": {
      "additionalProperties": true,
      "properties": {
        "retriggers": {
          "type": "integer"
        },
        "spinsAwarded": {
          "type": "integer"
        },
        "spinsPlayed": {
          "type": "integer"
        },
        "totalWin": {
          "type": "number"
        },
        "triggered": {
          "type": "boolean"
        }
      },
      "type": [
        "object",
        "null"
      ]
    },
    "gameId": {
      "const": 8001,
      "type": "integer"
    },
    "jackpot": {
      "description": "Must remain null for the current no-jackpot provisional model.",
      "type": [
        "object",
        "null"
      ]
    },
    "mathVersion": {
      "type": "string"
    },
    "operationId": {
      "description": "Provisional placeholder for new-games clientOperationId/idempotency linkage.",
      "type": "string"
    },
    "rngDebug": {
      "description": "Dev-only. Must not be sent to production client payloads.",
      "type": [
        "object",
        "null"
      ]
    },
    "roundId": {
      "type": "string"
    },
    "rtpVariant": {
      "enum": [
        "rtp_96",
        "rtp_94",
        "rtp_92"
      ],
      "type": "string"
    },
    "stateVersion": {
      "description": "Provisional runtime state version placeholder.",
      "type": [
        "integer",
        "string"
      ]
    },
    "totalWin": {
      "minimum": 0,
      "type": "number"
    },
    "walletAccounting": {
      "additionalProperties": true,
      "description": "Wallet/GS-owned accounting references only; browser must not own balance impact.",
      "properties": {
        "balanceAfter": {
          "type": [
            "number",
            "null"
          ]
        },
        "balanceBefore": {
          "type": [
            "number",
            "null"
          ]
        },
        "betTransactionId": {
          "type": "string"
        },
        "winTransactionId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "required": [
    "gameId",
    "roundId",
    "bet",
    "totalWin",
    "baseGame",
    "mathVersion",
    "rtpVariant"
  ],
  "title": "Little Gangster Backend Outcome Result Schema - Provisional",
  "type": "object"
}
